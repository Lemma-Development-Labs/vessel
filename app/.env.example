NEXT_PUBLIC_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_FALLBACK=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_USE_MOCK=1
NEXT_PUBLIC_EXPLORER=https://testnet.monadvision.com
# Optional Railway stats API (ChainProvider prefers /waterfall, falls back to getLogs)
NEXT_PUBLIC_STATS_URL=

# Server-side only. vessel-service base URL for the /api/auth/* rewrite (SIWE
# sign-in, invitations, consent). Unset -> onboarding reports auth unavailable.
# VESSEL_API_URL=http://127.0.0.1:3001

# Mainnet only: review scope + date shown in the PRIVATE MAINNET BETA banner.
# A mainnet build without it refuses to render the banner.
# NEXT_PUBLIC_REVIEW_STATUS=
