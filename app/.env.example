NEXT_PUBLIC_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_FALLBACK=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_USE_MOCK=1
NEXT_PUBLIC_EXPLORER=https://testnet.monadvision.com
# Optional Railway stats API (ChainProvider prefers /waterfall, falls back to getLogs)
NEXT_PUBLIC_STATS_URL=
# Dune — publish dune/queries/* then set; empty = /analytics Unavailable
NEXT_PUBLIC_DUNE_DASHBOARD_URL=
NEXT_PUBLIC_DUNE_QUERY_OVERVIEW=
# Server-only — never expose to the browser
DUNE_API_KEY=
# Short-manager keeper health (GET /health, GET /last-decision)
NEXT_PUBLIC_KEEPER_URL=
# Envio HyperIndex GraphQL — Transparency crank tape (never keeper JSON)
# After Envio Cloud promote, set to the hosted endpoint from docs/ADDRESSES.md
NEXT_PUBLIC_ENVIO_GRAPHQL=
