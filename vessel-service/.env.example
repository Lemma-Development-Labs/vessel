# JSON-RPC endpoint (Anvil, Monad testnet, or Monad mainnet)
RPC_URL=http://127.0.0.1:8545

# Must match the RPC. 10143 = Monad testnet, 143 = Monad, 31337 = Anvil
CHAIN_ID=10143

# Gas-only key. crank() is permissionless; this key never holds protocol funds.
# Leave unset to run API + indexer only — no transaction is ever signed or sent.
KEEPER_PK=0xYOUR_KEEPER_PRIVATE_KEY

# Seconds between crank attempts. Skip-reverts wait for the next tick (no tight retry).
# Also sets the stuck-tx receipt timeout: ~2 intervals, clamped to [30s, 15m].
CRANK_INTERVAL_SEC=300

# HTTP port. Always bound to 0.0.0.0. Railway/Render inject PORT.
PORT=3000

# Optional. If unset, waterfall + snapshots + the indexer cursor live in memory,
# so a restart re-backfills from deployedBlock. Set this for a real deployment.
DATABASE_URL=

# Full ADDRESSES.json blob. If unset, the service reads ../ADDRESSES.json
# ADDRESSES_JSON={"chainId":10143,"contracts":{"EngineLite":"0x…","Tranches":"0x…"},"deployedBlock":0,"venue":"sim"}

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------

# Blocks behind head treated as final. The persisted cursor never advances past
# (head - CONFIRMATIONS), and the indexer re-ingests that trailing window on every
# pass so a row that was reorged out is overwritten. Upserts are keyed on
# (tx_hash, log_index), so re-ingesting is idempotent. Default 12.
CONFIRMATIONS=12

# Milliseconds between indexer passes. Monad blocks are sub-second. Default 2000.
INDEXER_POLL_MS=2000

# eth_getLogs window in blocks. The public Monad testnet RPC rejects anything wider
# than 100 ("eth_getLogs is limited to a 100 range"), so 100 is the default. The
# indexer shrinks this automatically if the RPC rejects a range; raise it on a
# provider with a bigger limit to make the initial backfill far faster.
INDEXER_CHUNK_BLOCKS=100

# ---------------------------------------------------------------------------
# Keeper gas budget
# ---------------------------------------------------------------------------

# Monad charges gas_limit * price_per_gas — the LIMIT, not the gas used. The keeper
# refuses to start when balance / (gasLimit * gasPrice) is below this many cranks,
# and logs KEEPER-LOW-RUNWAY every cycle once it drops under. Default 50.
MIN_CRANKS_RUNWAY=50

# Hard ceiling, in gwei, on maxFeePerGas the keeper will sign. Above this the cycle
# is skipped rather than overpaying (also caps stuck-tx replacement bumps).
# Monad testnet baseFeePerGas floor is 100 gwei. Default 500.
MAX_GAS_PRICE_GWEI=500

# ---------------------------------------------------------------------------
# /health thresholds — these decide when /health returns ok:false + HTTP 503
# ---------------------------------------------------------------------------

# Crank intervals with no observed crank before /health goes degraded. Default 3.
HEALTH_MAX_CRANK_INTERVALS=3

# (safe head - persisted cursor) above which /health goes degraded. Default 1000.
HEALTH_MAX_INDEXER_LAG_BLOCKS=1000

# ---------------------------------------------------------------------------
# API: CORS + rate limiting
# ---------------------------------------------------------------------------

# Comma-separated exact-match CORS allowlist. Replaces the defaults entirely.
# Defaults (when unset): https://vessel.wtf, https://www.vessel.wtf,
# https://testnet.vessel.wtf, https://docs.vessel.wtf, http://localhost:3000,
# http://127.0.0.1:3000. Wildcards are rejected — name each preview domain.
# ALLOWED_ORIGINS=https://vessel.wtf,https://vessel-testnet.vercel.app

# Requests per window per IP on /stats and /waterfall. /health is not limited so a
# platform healthcheck always gets through. Defaults 60 per 60s.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
