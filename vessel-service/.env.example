# JSON-RPC endpoint (Anvil, Monad testnet, or Monad mainnet)
RPC_URL=http://127.0.0.1:8545

# Must match the RPC. 10143 = Monad testnet, 143 = Monad, 31337 = Anvil
CHAIN_ID=10143

# Gas-only key. crank() is permissionless; this key never holds protocol funds.
KEEPER_PK=0xYOUR_KEEPER_PRIVATE_KEY

# Seconds between crank attempts. Skip-reverts wait for the next tick (no tight retry).
CRANK_INTERVAL_SEC=300

# HTTP port. Always bound to 0.0.0.0. Railway/Render inject PORT.
PORT=3000

# Optional. If unset, waterfall + snapshots live in memory (lost on restart).
DATABASE_URL=

# Full ADDRESSES.json blob. If unset, the service reads ../ADDRESSES.json
# ADDRESSES_JSON={"chainId":10143,"contracts":{"EngineLite":"0x…","Tranches":"0x…"},"deployedBlock":0,"venue":"sim"}

LOG_LEVEL=info
