PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
# Opaque X-API-Key token from https://testnet.perpl.xyz/apikeys
PERPL_API_KEY=
# Hex of the 32-byte Ed25519 private key (no 0x prefix preferred)
PERPL_API_KEY_SECRET=
# Paid/dedicated Monad RPC — never poll testnet-rpc.monad.xyz in a loop
MONAD_RPC_URL=
# Gas-only EOA for EngineLite.crank (≠ API enrollment wallet if you want)
KEEPER_PK=
# EngineLite address (defaults from ADDRESSES.json if unset)
ENGINE_LITE=
# Perpl market id for the short (testnet MON = 64)
PERPL_MARKET_ID=64
# Max notional (6dec quote) per reduce/change action
MAX_NOTIONAL_PER_ACTION=100000000
# Health HTTP bind (Railway: 0.0.0.0:$PORT)
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3001
# Touch this file to force halt
KILL_SWITCH_PATH=./KILL
